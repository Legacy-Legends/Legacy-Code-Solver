# Copy to .env and enter a NEW key privately. Never commit .env.
# Read by Uvicorn only when --env-file .env is supplied.
LLM_PROVIDER=groq
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-20b
USE_MOCK_AGENT=false
# The presentation UI currently opens the checked-in demo graph.
USE_CACHED_DEMO=true

# For a separately deployed frontend, set this on the FRONTEND build service.
# Use the public backend origin, without /api. Never put a secret in a VITE_ variable.
# VITE_API_URL=https://YOUR-BACKEND-SERVICE.onrender.com
