# Copy to .env and enter a NEW key privately. Never commit .env.
# Read by Uvicorn only when --env-file .env is supplied.
LLM_PROVIDER=groq
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-20b
USE_MOCK_AGENT=false
# Until upload/analysis is implemented, the API still serves the demo graph.
USE_CACHED_DEMO=true
